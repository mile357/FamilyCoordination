    { "name": "Glyph Cyan", "hex": "#00D4AA" },
    { "name": "Glyph Amber", "hex": "#FF9500" }
  ],
  "extensionAccents": {
    "calendar": "#D71921",
    "meals": "#F5F5F5",
    "groceries": "#00D4AA",
    "chores": "#FF9500",
    "notes": "#A1A1AA",
    "task-checklist": "#D71921"
  },
  "metaThemeColor": {
    "dark": "#000000",
    "light": "#F2F2F2"
  },
  "preview": {
    "dark": { "canvas": "#000000", "tile": "#121212", "accent": "#D71921" },
    "light": { "canvas": "#F2F2F2", "tile": "#FFFFFF", "accent": "#D71921" }
