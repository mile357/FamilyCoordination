{
  "id": "nothing",
  "name": "Nothing OS",
  "description": "High-contrast monochrome minimalism with Nothing signature crimson accents, pill containers, and dot-matrix inspired typography.",
  "author": "Family Hub",
  "order": 9,
  "stylesheet": "theme.css",
  "modes": ["dark", "light"],
  "defaultMode": "dark",
  "defaultAccent": "#D71921",
